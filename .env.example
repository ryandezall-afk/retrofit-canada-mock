# Google Gemini API (server-side only)
# Leave GEMINI_API_KEY blank to run automatically with the built-in mock retrofit assessment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to force mock retrofit assessment even when GEMINI_API_KEY is set
USE_MOCK_ASSESSMENT=false

# Mock Retrofit Canada API cache TTL in milliseconds (default: 3600000 = 1 hour)
RETROFIT_CANADA_CACHE_TTL_MS=3600000

# Optional real Retrofit Canada API credentials (when provided by Retrofit Canada)
# Leave unset to use the local mock Retrofit Canada API dataset
RETROFIT_CANADA_API_URL=
RETROFIT_CANADA_API_KEY=
