# Google Gemini API (server-side only)
# Leave GEMINI_API_KEY blank to run automatically with the built-in mock retrofit assessment
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to "true" to force mock retrofit assessment even when GEMINI_API_KEY is set
USE_MOCK_ASSESSMENT=false

# ----------------------------------------------------------------------------------------------
# Case studies: Retrofit Canada API -> Supabase -> this site (see README → Case studies)
# ----------------------------------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Data API: "Project URL"
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys: "Publishable key" (sb_publishable_...).
# Used by the website to READ case studies. It can only read published case studies (RLS),
# so it's fine to share with the team.
SUPABASE_PUBLISHABLE_KEY=
# Supabase dashboard -> Project Settings -> API Keys: "Secret key" (sb_secret_...).
# Used ONLY by the monthly sync to WRITE. Full database access: never commit it, never paste it
# in Teams/screenshots, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Any long random string you make up. Vercel Cron sends it to /api/cron/sync-case-studies;
# requests without it are refused. Make one in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
CRON_SECRET=

# Optional. Retrofit Canada's public API (no key needed). Default shown.
# RETROFIT_CANADA_API_BASE=https://portal.retrofitcanada.com/api/v1

# How long the advisor keeps case studies in memory, in milliseconds (default 1 hour)
RETROFIT_CANADA_CACHE_TTL_MS=3600000
